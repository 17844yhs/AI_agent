GET /索引/_search
{ 
    "query": { 
    "bool": { 
      // 必须满足的条件 
      "must": [ 
                搜索方式:搜索参数,
                搜索方式:搜索参数
       ],
      // 多个条件有任意一个满足即可
      "should": [
                搜索方式:搜索参数,
               搜索方式:搜索参数
           ],
        // 必须不满足的条件
        "must_not":[
            搜索方式:搜索参数,
            搜索方式:搜索参数
        ]
       } 
   } 
}
